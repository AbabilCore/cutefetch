{
  "name": "cutefetch",
  "version": "1.1.1",
  "description": "A sleek and minimalistic HTTP client for modern web and Node.js applications, designed with simplicity and elegance in mind.",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npx tsx scripts/index.ts && tsup && rimraf temp-banner.txt",
    "dev": "npx tsx watch test/index.ts"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "http client",
    "ajax",
    "fetch",
    "request",
    "api",
    "network",
    "promise",
    "cutefetch"
  ],
  "author": "Md Ababil Hossain (https://devababil.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevAbabil/cutefetch.git"
  },
  "bugs": {
    "url": "https://github.com/DevAbabil/cutefetch/issues"
  },
  "homepage": "https://github.com/DevAbabil/cutefetch#readme",
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "handlebars": "^4.7.8",
    "rimraf": "^5.0.10",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
